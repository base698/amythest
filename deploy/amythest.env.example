# Amythest secrets — copy to ~/.config/amythest/env (chmod 600).
# Kanban (omit all three to disable the kanban app):
KANBAN_USERNAME=you
KANBAN_PASSWORD=change-me-min-10-chars
KANBAN_SESSION_SECRET=change-me-to-32-plus-random-bytes!!
KANBAN_COOKIE_SECURE=true
# MCP endpoint bearer token (omit to disable /mcp):
AMYTHEST_MCP_TOKEN=change-me-random-token
